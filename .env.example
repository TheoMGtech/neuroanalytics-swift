# Application
APP_NAME=NeuroAnalytics
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api

# Frontend
VITE_API_URL=http://localhost:8000

# Database
POSTGRES_USER=neuro
POSTGRES_PASSWORD=neuro
POSTGRES_DB=neuroanalytics
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://neuro:neuro@database:5432/neuroanalytics
DIRECT_URL=postgresql://neuro:neuro@database:5432/neuroanalytics

# Upload
MAX_UPLOAD_SIZE_MB=30
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
